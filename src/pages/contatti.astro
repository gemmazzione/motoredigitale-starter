---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Contatti | Motore Digitale"
  description="Contatta Motore Digitale."
>
  <Header />

  <main>

    <section class="contact section">
      <div class="container contact-grid">

        <div>
          <p class="eyebrow">Contatti</p>

          <h1>
            Parliamo del tuo progetto.
          </h1>
        </div>

        <div class="contact-info">

          <p>
            Raccontaci cosa vuoi realizzare.
          </p>

          <a href="mailto:info@motoredigitale.com">
            info@motoredigitale.com
          </a>

          <a href="https://www.motoredigitale.com">
            motoredigitale.com
          </a>

        </div>

      </div>
    </section>

  </main>

  <Footer
    companyName="Motore Digitale"
    email="info@motoredigitale.com"
  />

</BaseLayout>

<style>
  .contact-grid {
    min-height: 65vh;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .eyebrow {
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
  }

  h1 {
    max-width: 800px;
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .contact-info {
    display: grid;
    gap: 1rem;
    font-size: 1.2rem;
  }

  .contact-info p {
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>