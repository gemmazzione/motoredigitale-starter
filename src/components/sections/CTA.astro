---
interface Props {
  title: string;
  text?: string;
  label?: string;
  href?: string;
}

const {
  title,
  text,
  label = "Contattaci",
  href = "/contatti/",
} = Astro.props;
---

<section class="cta-section">
  <div class="container">

    <div class="cta-box">

      <h2>{title}</h2>

      {text && (
        <p>{text}</p>
      )}

      <a href={href}>
        {label}
      </a>

    </div>

  </div>
</section>

<style>
  .cta-section {
    padding-block: var(--space-xl);
  }

  .cta-box {
    padding: clamp(2rem, 6vw, 5rem);
    background: var(--color-text);
    color: var(--color-bg);
    border-radius: var(--radius-lg);
  }

  h2 {
    max-width: 900px;
    margin-bottom: 1.5rem;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  p {
    max-width: 600px;
    opacity: 0.7;
    font-size: 1.1rem;
  }

  a {
    display: inline-block;
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: var(--radius-sm);
  }
</style>