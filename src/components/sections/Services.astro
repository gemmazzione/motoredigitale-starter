---
interface Service {
  number?: string;
  title: string;
  text: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  services: Service[];
}

const {
  eyebrow = "Servizi",
  title = "Cosa possiamo fare.",
  services,
} = Astro.props;
---

<section class="services-section section">
  <div class="container">

    <div class="services-heading">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>

    <div class="services-list">
      {
        services.map((service, index) => (
          <article class="service">
            <span class="number">
              {service.number ?? String(index + 1).padStart(2, "0")}
            </span>

            <div>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </div>

            {service.href && (
              <a href={service.href} aria-label={`Scopri ${service.title}`}>
                →
              </a>
            )}
          </article>
        ))
      }
    </div>

  </div>
</section>

<style>
  .services-heading {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  .eyebrow {
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
  }

  h2 {
    max-width: 800px;
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .services-list {
    border-top: 1px solid var(--color-border);
  }

  .service {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    gap: 2rem;
    align-items: start;
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .number {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  h3 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    letter-spacing: -0.04em;
  }

  p {
    max-width: 650px;
    margin: 0;
    color: var(--color-muted);
  }

  .service > a {
    font-size: 2rem;
  }

  @media (max-width: 768px) {
    .services-heading {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .service {
      grid-template-columns: 45px 1fr;
    }

    .service > a {
      display: none;
    }
  }
</style>