---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  eyebrow,
  title,
  text,
  primaryLabel,
  primaryHref = "#",
  secondaryLabel,
  secondaryHref = "#",
} = Astro.props;
---

<section class="hero">
  <div class="container hero-inner">

    {eyebrow && (
      <p class="eyebrow">
        {eyebrow}
      </p>
    )}

    <h1>{title}</h1>

    {text && (
      <p class="hero-text">
        {text}
      </p>
    )}

    <div class="hero-actions">
      {primaryLabel && (
        <a class="primary" href={primaryHref}>
          {primaryLabel}
        </a>
      )}

      {secondaryLabel && (
        <a class="secondary" href={secondaryHref}>
          {secondaryLabel}
        </a>
      )}
    </div>

  </div>
</section>

<style>
  .hero {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding-block: 6rem;
  }

  .hero-inner {
    width: 100%;
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 1000px;
    margin-bottom: 1.5rem;
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .hero-text {
    max-width: 650px;
    color: var(--color-muted);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.9rem 1.2rem;
    border-radius: var(--radius-sm);
    transition:
      transform var(--transition),
      opacity var(--transition);
  }

  .primary {
    background: var(--color-accent);
    color: white;
  }

  .secondary {
    border: 1px solid var(--color-border);
  }

  .primary:hover,
  .secondary:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding-block: 5rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>